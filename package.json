      "uuid": "^11.1.1",
      "undici": "^7.30.2",
      "proxy-addr": "^2.0.8",
      "body-parser@2": "^2.4.0",
      "qs": "^6.17.1",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "nanoid@3": "^3.3.18",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "vite": "^7.3.7",
      "esbuild@<=0.24.2": "^0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/core dev",
    "start": "pnpm --filter @atlas/core start",
