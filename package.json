{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "description": "ATLAS — Enterprise Operating System of AGHA RM INFRA",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
